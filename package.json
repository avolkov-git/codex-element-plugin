{
  "name": "codex-element-v1",
  "displayName": "Codex for 1C: Element",
  "description": "Claude Code-style Codex plugin shell for 1C: Element.",
  "version": "1.0.3",
  "publisher": "element-ai",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:codexElement.sidebar",
    "onWebviewPanel:codexElement.chatPanel",
    "onWebviewPanel:codexElement.settingsPanel",
    "onCommand:codexElement.open",
    "onCommand:codexElement.newProjectChat",
    "onCommand:codexElement.newGeneralChat",
    "onCommand:codexElement.openProjectRules",
    "onCommand:codexElement.openSettings",
    "onCommand:codexElement.openLogs",
    "onCommand:codexElement.openLogFolder",
    "onCommand:codexElement.exportLogsToWorkspace",
    "onCommand:codexElement.probeCapabilities",
    "onCommand:codexElement.explainFile",
    "onCommand:codexElement.explainSelection"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npm run build:webview && tsc -p ./",
    "build:webview": "node scripts/build-xbsl-highlighter.js && node scripts/build-chat-ui.js && node scripts/build-settings-icons.js",
    "check": "npm run check:webview && npm run check:highlight && tsc -p ./ --noEmit",
    "check:webview": "node scripts/build-xbsl-highlighter.js --check && node scripts/build-chat-ui.js --check && node scripts/build-settings-icons.js --check && tsc -p webview/chat/tsconfig.json",
    "check:chat-ui": "node scripts/chat-ui-check.cjs",
    "check:chat-shortcuts": "node scripts/chat-composer-shortcuts-check.cjs",
    "check:experimental-context": "node --test tests/experimental-context.test.cjs tests/settings-panel.test.cjs && node scripts/settings-context-check.cjs",
    "check:chat-questions": "node scripts/chat-questions-check.cjs",
    "check:chat-design": "node scripts/chat-design-check.cjs",
    "check:pressure": "node --test tests/chat-pressure.test.cjs tests/docs-worker.test.cjs tests/logger.test.cjs tests/pressure-monitor.test.cjs && node scripts/rc-history-pressure-check.js",
    "check:chat-pressure": "node scripts/chat-pressure-check.cjs",
    "check:history": "node scripts/rc-history-check.js",
    "check:identity": "node --test tests/element-console-identity.test.cjs && node scripts/rc-identity-transition-check.js",
    "check:startup": "node --test tests/extension-startup.test.cjs",
    "check:runtime": "node --test tests/chat-questions.test.cjs && node scripts/rc-runtime-check.js",
    "check:runtime-payload": "node --test tests/runtime-payload.test.cjs",
    "check:features": "node scripts/rc-features-check.js",
    "check:services": "node --test tests/service-reliability.test.cjs",
    "check:browser-runtime": "node --test tests/browser-runtime.test.cjs tests/element-application.test.cjs tests/settings-panel.test.cjs tests/base-context-settings.test.cjs",
    "check:settings-browser": "node scripts/settings-browser-check.cjs",
    "check:browser-highlighter": "node --test tests/browser-highlighter.test.cjs",
    "check:highlight": "node scripts/xbsl-highlighter-check.js",
    "check:markdown-links": "node scripts/markdown-file-link-check.js",
    "check:transcript-window": "node scripts/transcript-window-check.js",
    "check:mcp-elicitation": "node scripts/mcp-elicitation-policy-check.js",
    "check:models": "node scripts/model-catalog-check.js",
    "check:protocol": "node scripts/app-server-protocol-check.js",
    "eval:context": "node scripts/context-acceptance-check.js",
    "preflight:runtime": "node scripts/verify-runtime-binaries.js --require-current",
    "preflight:runtime:release": "node scripts/verify-runtime-binaries.js --require-all",
    "preflight:runtime:dry-run": "node scripts/simulate-runtime-env.js --platform win32-x64 --allow-lfs-pointer",
    "preflight:deploy": "node scripts/verify-deploy-payload.js --platform win32-x64 --allow-lfs-pointer",
    "preflight:deploy:release": "node scripts/verify-deploy-payload.js --root ../codex-plugin-deploy --require-all --strict",
    "deploy:stage": "node scripts/stage-deploy-payload.js --target ../codex-plugin-deploy --platform win32-x64 --allow-lfs-pointer",
    "deploy:stage:strict": "node scripts/stage-deploy-payload.js --target ../codex-plugin-deploy --platform win32-x64 --strict",
    "deploy:stage:release": "node scripts/stage-deploy-payload.js --target ../codex-plugin-deploy --require-all --strict",
    "browser:prepare": "node scripts/prepare-browser-runtime.js",
    "release:platforms": "npm run build && node scripts/package-platform-releases.js",
    "smoke:unix": "node scripts/unix-smoke-check.js --platform linux-x64"
  },
  "contributes": {
    "commands": [
      {
        "command": "codexElement.open",
        "title": "Codex: Открыть"
      },
      {
        "command": "codexElement.newProjectChat",
        "title": "Codex: Новый проектный чат",
        "icon": "$(add)"
      },
      {
        "command": "codexElement.newGeneralChat",
        "title": "Codex: Новый общий чат",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codexElement.openSettings",
        "title": "Codex: Настройки",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codexElement.openLogs",
        "title": "Codex: Логи",
        "icon": "$(output)"
      },
      {
        "command": "codexElement.openLogFolder",
        "title": "Codex: Открыть папку логов",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codexElement.exportLogsToWorkspace",
        "title": "Codex: Экспортировать логи в workspace",
        "icon": "$(export)"
      },
      {
        "command": "codexElement.probeCapabilities",
        "title": "Codex: Проверить возможности app-server",
        "icon": "$(beaker)"
      },
      {
        "command": "codexElement.openProjectRules",
        "title": "Codex: Открыть правила проекта",
        "icon": "$(checklist)"
      },
      {
        "command": "codexElement.explainFile",
        "title": "Объяснить файл",
        "category": "Codex",
        "icon": "$(file-code)"
      },
      {
        "command": "codexElement.explainSelection",
        "title": "Объяснить выделенный фрагмент",
        "category": "Codex",
        "icon": "$(selection)"
      }
    ],
    "submenus": [
      {
        "id": "codexElement.editorContext",
        "label": "Codex for 1C Element"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexElement",
          "title": "Codex",
          "icon": "resources/icons/codex.svg"
        }
      ]
    },
    "views": {
      "codexElement": [
        {
          "type": "webview",
          "id": "codexElement.sidebar",
          "name": "Codex"
        }
      ]
    },
    "configuration": {
      "title": "Codex",
      "properties": {
        "codexElement.configRoot": {
          "type": "string",
          "default": "",
          "description": "Каталог хранения настроек Codex Element вне каталога плагина. Пусто = auto."
        },
        "codexElement.elementMcpUrl": {
          "type": "string",
          "default": "http://127.0.0.1:9900",
          "description": "Локальный адрес 1C Element MCP для безопасной передачи контекста текущей IDE."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "codexElement.openSettings",
          "when": "view == codexElement.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "codexElement.openLogs",
          "when": "view == codexElement.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "codexElement.openLogFolder",
          "when": "view == codexElement.sidebar",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "submenu": "codexElement.editorContext",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "z_codex@999"
        }
      ],
      "codexElement.editorContext": [
        {
          "command": "codexElement.explainFile",
          "group": "navigation@1"
        },
        {
          "command": "codexElement.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "codexElement.open"
        },
        {
          "command": "codexElement.newProjectChat"
        },
        {
          "command": "codexElement.newGeneralChat"
        },
        {
          "command": "codexElement.openSettings"
        },
        {
          "command": "codexElement.openLogs"
        },
        {
          "command": "codexElement.openLogFolder"
        },
        {
          "command": "codexElement.exportLogsToWorkspace"
        },
        {
          "command": "codexElement.probeCapabilities"
        },
        {
          "command": "codexElement.openProjectRules"
        },
        {
          "command": "codexElement.explainFile"
        },
        {
          "command": "codexElement.explainSelection",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "devDependencies": {
    "@shikijs/core": "^4.3.1",
    "@shikijs/engine-javascript": "^4.3.1",
    "@shikijs/langs": "^4.3.1",
    "@tanstack/react-virtual": "3.14.11",
    "@types/node": "^20.11.30",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/vscode": "^1.97.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.25.12",
    "lucide-react": "1.43.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "^5.4.5"
  }
}
